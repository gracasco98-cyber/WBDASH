# ══════════════════════════════════════════════════════════════════════════════
#  Dashboard — Environment Variables (template)
#  Copy this file to .env and fill in every value.  Never commit .env.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────────
# Strong random password — generate with: openssl rand -hex 32
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/shopify_dashboard

# ── Auth ────────────────────────────────────────────────────────────────────────
# Minimum 32 chars — generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
SESSION_MAX_AGE_HOURS=8
NODE_ENV=production

# Master (superadmin) account seeded on first start
MASTER_EMAIL=admin@example.com
MASTER_PASSWORD=CHANGE_ME

# ── Server / Frontend ─────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://dashboard.example.com
# NEXT_PUBLIC_API_URL is baked into the frontend image at build time (docker-compose.prod.yml)

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=CHANGE_ME
SHOPIFY_WEBHOOK_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME

# ── Amazon SP-API ─────────────────────────────────────────────────────────────
AMAZON_LWA_CLIENT_ID=CHANGE_ME
AMAZON_LWA_CLIENT_SECRET=CHANGE_ME
AMAZON_EU_REFRESH_TOKEN=CHANGE_ME
AMAZON_US_REFRESH_TOKEN=CHANGE_ME

# ── Amazon Advertising API ────────────────────────────────────────────────────
AMAZON_ADVERTISING_CLIENT_ID=CHANGE_ME
AMAZON_ADVERTISING_CLIENT_SECRET=CHANGE_ME
AMAZON_ADVERTISING_REFRESH_TOKEN=CHANGE_ME

# Profile IDs from GET /v2/profiles
AMAZON_ADVERTISING_PROFILE_IT=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_DE=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_FR=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_ES=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_UK=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_NL=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_BE=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_SE=CHANGE_ME
AMAZON_ADVERTISING_PROFILE_PL=CHANGE_ME
