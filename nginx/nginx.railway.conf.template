worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent"';
  access_log /var/log/nginx/access.log main;

  sendfile        on;
  keepalive_timeout 65;

  # ── Security — hide nginx version ─────────────────────────────────────────
  server_tokens off;

  # ── Gzip ──────────────────────────────────────────────────────────────────
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_types text/plain text/css text/xml application/json
             application/javascript application/xml+rss
             application/atom+xml image/svg+xml;

  # Railway's edge terminates TLS and forwards to this container over plain
  # HTTP — nginx's own $scheme is therefore always "http", regardless of
  # what the browser actually used. Overwriting X-Forwarded-Proto with
  # $scheme (as a from-scratch reverse-proxy config normally would) tells
  # the backend every request is insecure, which makes express-session
  # silently refuse to set its `secure` cookie — login "succeeds" but no
  # session cookie ever reaches the browser. Preserve whatever
  # X-Forwarded-Proto the edge already set instead, falling back to
  # $scheme only when hit directly (e.g. local `docker run`).
  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
  }

  # ── HTTP server ─────────────────────────────────────────────────────────
  # TLS is terminated at Railway's edge proxy; this container only ever
  # receives plain HTTP on the port Railway routes the custom domain to.
  server {
    listen 8080;

    # Railway's private-network hostnames aren't always resolvable the
    # instant this container boots (the backend/frontend service may still
    # be deploying). A static `upstream {}` block resolves once at config
    # load and makes nginx refuse to start if that lookup fails at that
    # moment. Resolving through a variable instead defers DNS lookup to
    # request time (cached per `valid=`), so nginx always starts cleanly
    # and picks up the backend/frontend once they're actually up.
    resolver ${RESOLVER_IP} valid=5s;
    set $backend_upstream  http://wbdash.railway.internal:3001;
    set $frontend_upstream http://frontend.railway.internal:3000;

    # ── Security headers ─────────────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff"                                      always;
    add_header X-Frame-Options           "DENY"                                         always;
    add_header X-XSS-Protection          "1; mode=block"                                always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"              always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=()"     always;
    add_header Content-Security-Policy
      "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"
      always;

    # ── Request size limit ───────────────────────────────────────────────────
    client_max_body_size 10m;

    # ── SSE — real-time stream (no buffer, very long timeout) ────────────────
    location /api/sse {
      proxy_pass         $backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $forwarded_proto;
      proxy_set_header   Connection        "";
      proxy_buffering    off;
      proxy_cache        off;
      proxy_read_timeout 86400s;
      add_header         X-Accel-Buffering no;
    }

    # ── Backend: API + webhooks ───────────────────────────────────────────────
    location /api/ {
      proxy_pass         $backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $forwarded_proto;
      proxy_set_header   Connection        "";
      proxy_buffering    off;
      proxy_cache        off;
      proxy_read_timeout 120s;
      proxy_send_timeout 120s;
    }

    location /webhooks/ {
      proxy_pass         $backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $forwarded_proto;
      proxy_set_header   Connection        "";
      proxy_read_timeout 30s;
    }

    location /health {
      proxy_pass         $backend_upstream/health;
      proxy_set_header   Host $host;
      access_log         off;
    }

    # ── Next.js static assets — aggressive cache (content-hashed names) ───────
    location /_next/static/ {
      proxy_pass         $frontend_upstream;
      proxy_http_version 1.1;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $forwarded_proto;
      add_header         Cache-Control "public, max-age=31536000, immutable";
      access_log         off;
    }

    # ── Frontend: Next.js HTML — never cache (always fresh after deploy) ───────
    location / {
      proxy_pass         $frontend_upstream;
      proxy_http_version 1.1;
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $forwarded_proto;
      proxy_set_header   Upgrade           $http_upgrade;
      proxy_set_header   Connection        "upgrade";
      proxy_read_timeout 60s;
      add_header         Cache-Control "no-store, no-cache, must-revalidate" always;
      add_header         Pragma        "no-cache"                             always;
    }
  }
}
