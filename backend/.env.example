# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SHOPIFY_WEBHOOK_SECRET=

# Mirakl (Redcare / Shop-Apotheke)
MIRAKL_API_URL=https://shopapotheke.mirakl.net/api
MIRAKL_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/shopify_dashboard

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Optional CSV allow-list for the 10-minute Amazon Ads sync (example: IT,DE).
# Empty/unset means every Ads profile configured on the Amazon account.
AMAZON_ADS_SYNC_MARKETPLACES=
